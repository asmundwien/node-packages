{
  "name": "@asmundwien/node-packages",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "knip": "knip",
    "knip:check": "knip",
    "typecheck": "turbo run typecheck",
    "package-manifests": "sherif --fix",
    "package-manifests:check": "sherif",
    "github-actions:check": "github-actionlint .github/workflows/*.yml",
    "rulesync:install": "rulesync install",
    "rulesync:update": "rulesync install --update",
    "rulesync:preview": "rulesync generate --dry-run",
    "rulesync:apply": "rulesync generate"
  },
  "devDependencies": {
    "github-actionlint": "1.7.12",
    "knip": "6.45.1",
    "rulesync": "43.8.0",
    "sherif": "1.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.19.0"
}
