{
  "$schema": "https://json.schemastore.org/tsconfig",
  // [standardization] Inherit shared source policy before adding the Node environment so runtime selection does not discard the shared checks.
  "extends": "./base.json",
  "compilerOptions": {
    // [standardization] Emit ES2022-compatible syntax so Node projects share one output baseline rather than follow compiler defaults.
    "target": "ES2022",
    // [correctness] Restrict standard-library types to the selected ES2022 baseline so type checking does not promise newer APIs by default.
    "lib": ["ES2022"],
    // [correctness] Load Node globals explicitly instead of auto-including every visible @types package; dependencies can still supply imported types.
    "types": ["node"],
    // [correctness] Match Node's ESM/CommonJS classification and resolution so checked import paths agree with runtime package metadata.
    "module": "NodeNext"
  }
}
