{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^lint:check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
